<?php

namespace App\Http\Controllers;

use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;
use RuntimeException;

class AsaasWebhookController extends Controller
{
    public function handle(Request $request): JsonResponse
    {
        $expectedToken = (string) config('services.asaas.webhook_token');
        $receivedToken = (string) $request->header('asaas-access-token');

        if ($expectedToken === '') {
            abort(503, 'Token do webhook não configurado.');
        }

        if (! hash_equals($expectedToken, $receivedToken)) {
            abort(401, 'Token do webhook inválido.');
        }

        $data = $request->validate([
            'id' => ['required', 'string', 'max:150'],
            'event' => [
                'required',
                'in:CHECKOUT_CREATED,CHECKOUT_PAID,CHECKOUT_CANCELED,CHECKOUT_EXPIRED',
            ],
            'checkout' => ['required', 'array'],
            'checkout.id' => ['required', 'string', 'max:120'],
            'checkout.status' => ['required', 'in:ACTIVE,PAID,CANCELED,EXPIRED'],
        ]);

        $eventId = $data['id'];
        $eventType = $data['event'];
        $checkoutId = $data['checkout']['id'];
        $checkoutStatus = $data['checkout']['status'];

        $expectedStatuses = [
            'CHECKOUT_CREATED' => 'ACTIVE',
            'CHECKOUT_PAID' => 'PAID',
            'CHECKOUT_CANCELED' => 'CANCELED',
            'CHECKOUT_EXPIRED' => 'EXPIRED',
        ];

        $statusMatches = $checkoutStatus === $expectedStatuses[$eventType];
        $checkoutItems = [];

        if ($eventType === 'CHECKOUT_PAID') {
            $itemsData = $request->validate([
                'checkout.items' => ['required', 'array', 'min:1'],
                'checkout.items.*.name' => ['required', 'string', 'max:150'],
                'checkout.items.*.quantity' => ['required', 'integer', 'min:1'],
                'checkout.items.*.value' => ['required', 'numeric', 'gt:0'],
            ]);

            $checkoutItems = $itemsData['checkout']['items'];
        }

        $result = DB::transaction(function () use (
            $eventId,
            $eventType,
            $checkoutId,
            $checkoutStatus,
            $statusMatches,
            $checkoutItems
        ): array {
            $inserted = DB::table('asaas_webhook_events')->insertOrIgnore([
                'event_id' => $eventId,
                'event_type' => $eventType,
                'processing_status' => 'pending',
                'received_at' => now(),
                'created_at' => now(),
                'updated_at' => now(),
            ]);

            if ($inserted === 0) {
                return ['duplicate' => true, 'review' => false];
            }

            $order = DB::table('site_test_orders')
                ->where('asaas_checkout_id', $checkoutId)
                ->lockForUpdate()
                ->first();

            if (! $order) {
                throw new RuntimeException(
                    'Pedido não encontrado para o Checkout '.$checkoutId
                );
            }

            $reviewReason = null;

            if (! $statusMatches) {
                $reviewReason = 'O estado do Checkout não corresponde ao evento recebido.';
            }

            if ($eventType === 'CHECKOUT_PAID' && $statusMatches) {
                if (
                    $order->payment_status === 'paid_review'
                    || $order->order_status === 'payment_review'
                ) {
                    $reviewReason = 'Pedido já está em revisão e exige conferência manual.';
                } elseif ($order->reservation_released_at !== null) {
                    $reviewReason = 'Pagamento informado após a liberação do estoque.';

                    if ($order->payment_status !== 'confirmed') {
                        DB::table('site_test_orders')
                            ->where('id', $order->id)
                            ->update([
                                'order_status' => 'payment_review',
                                'payment_status' => 'paid_review',
                                'paid_at' => now(),
                                'updated_at' => now(),
                            ]);
                    }
                } elseif ($order->payment_status !== 'confirmed') {
                    $savedItems = DB::table('site_test_order_items')
                        ->where('order_id', $order->id)
                        ->orderBy('id')
                        ->get([
                            'product_name',
                            'quantity',
                            'unit_price_cents',
                            'total_cents',
                        ]);

                    $expectedItems = [];
                    $receivedItems = [];
                    $savedTotalCents = 0;
                    $receivedTotalCents = 0;
                    $itemsAreValid = $savedItems->isNotEmpty();

                    foreach ($savedItems as $item) {
                        $unitCents = (int) $item->unit_price_cents;
                        $quantity = (int) $item->quantity;
                        $lineTotal = (int) $item->total_cents;

                        if (
                            $unitCents <= 0
                            || $quantity <= 0
                            || $lineTotal !== $unitCents * $quantity
                        ) {
                            $itemsAreValid = false;
                            break;
                        }

                        $key = json_encode([
                            $item->product_name,
                            $unitCents,
                        ], JSON_UNESCAPED_UNICODE);

                        $expectedItems[$key] =
                            ($expectedItems[$key] ?? 0) + $quantity;

                        $savedTotalCents += $lineTotal;
                    }

                    foreach ($checkoutItems as $item) {
                        $unitCents = (int) round(
                            ((float) $item['value']) * 100
                        );
                        $quantity = (int) $item['quantity'];

                        if ($unitCents <= 0 || $quantity <= 0) {
                            $itemsAreValid = false;
                            break;
                        }

                        $key = json_encode([
                            $item['name'],
                            $unitCents,
                        ], JSON_UNESCAPED_UNICODE);

                        $receivedItems[$key] =
                            ($receivedItems[$key] ?? 0) + $quantity;

                        $receivedTotalCents += $unitCents * $quantity;
                    }

                    ksort($expectedItems);
                    ksort($receivedItems);

                    $itemsMatch = $itemsAreValid
                        && $expectedItems === $receivedItems
                        && $savedTotalCents === (int) $order->total_cents
                        && $receivedTotalCents === (int) $order->total_cents;

                    if (! $itemsMatch) {
                        $reviewReason = 'Os itens, quantidades ou preços do Checkout não correspondem ao pedido.';

                        DB::table('site_test_orders')
                            ->where('id', $order->id)
                            ->update([
                                'order_status' => 'payment_review',
                                'payment_status' => 'paid_review',
                                'paid_at' => now(),
                                'updated_at' => now(),
                            ]);
                    } else {
                        DB::table('site_test_orders')
                            ->where('id', $order->id)
                            ->update([
                                'order_status' => 'paid',
                                'payment_status' => 'confirmed',
                                'paid_at' => now(),
                                'updated_at' => now(),
                            ]);

                        $outboxExists = DB::table('pdv_site_order_outbox')
                            ->where('order_id', $order->id)
                            ->exists();

                        if (! $outboxExists) {
                            DB::table('pdv_site_order_outbox')->insert([
                                'event_id' => (string) Str::uuid(),
                                'order_id' => $order->id,
                                'created_at' => now(),
                                'updated_at' => now(),
                            ]);
                        }
                    }
                }
            }

            if (
                in_array($eventType, [
                    'CHECKOUT_CANCELED',
                    'CHECKOUT_EXPIRED',
                ], true)
                && $statusMatches
            ) {
                if (
                    $order->payment_status === 'confirmed'
                    || $order->order_status === 'paid'
                ) {
                    $reviewReason = 'Evento de cancelamento ou expiração recebido para pedido já confirmado. Estoque preservado.';
                } elseif ($order->payment_status === 'paid_review') {
                    $reviewReason = 'Pedido com pagamento em revisão. Estoque preservado para conferência.';
                } elseif ($order->reservation_released_at === null) {
                    if (! in_array(
                        $order->payment_status,
                        ['pending', 'checkout_unknown'],
                        true
                    )) {
                        $reviewReason = 'Estado do pedido não permite liberação automática do estoque.';
                    } else {
                        $items = DB::table('site_test_order_items')
                            ->where('order_id', $order->id)
                            ->orderBy('id')
                            ->get(['product_id', 'variant_id', 'quantity']);

                        $productIds = $items->pluck('product_id')
                            ->unique()->sort()->values();

                        $variantIds = $items->pluck('variant_id')
                            ->filter()->unique()->sort()->values();

                        if ($productIds->isNotEmpty()) {
                            DB::table('product')
                                ->whereIn('id', $productIds)
                                ->orderBy('id')
                                ->lockForUpdate()
                                ->get(['id']);
                        }

                        if ($variantIds->isNotEmpty()) {
                            DB::table('product_variants')
                                ->whereIn('id', $variantIds)
                                ->orderBy('id')
                                ->lockForUpdate()
                                ->get(['id']);
                        }

                        foreach ($items as $item) {
                            $productUpdated = DB::table('product')
                                ->where('id', $item->product_id)
                                ->increment('qty', (int) $item->quantity);

                            if ($productUpdated !== 1) {
                                throw new RuntimeException(
                                    'Não foi possível devolver o estoque do produto '.$item->product_id
                                );
                            }

                            if ($item->variant_id !== null) {
                                $variantUpdated = DB::table('product_variants')
                                    ->where('id', $item->variant_id)
                                    ->increment('qty', (int) $item->quantity);

                                if ($variantUpdated !== 1) {
                                    throw new RuntimeException(
                                        'Não foi possível devolver o estoque da variação '.$item->variant_id
                                    );
                                }
                            }
                        }

                        $finalStatus = strtolower($checkoutStatus);

                        DB::table('site_test_orders')
                            ->where('id', $order->id)
                            ->update([
                                'order_status' => $finalStatus,
                                'payment_status' => $finalStatus,
                                'reservation_released_at' => now(),
                                'updated_at' => now(),
                            ]);
                    }
                }
            }

            DB::table('asaas_webhook_events')
                ->where('event_id', $eventId)
                ->update([
                    'processing_status' => $reviewReason === null
                        ? 'processed'
                        : 'review',
                    'last_error' => $reviewReason,
                    'processed_at' => $reviewReason === null ? now() : null,
                    'updated_at' => now(),
                ]);

            return [
                'duplicate' => false,
                'review' => $reviewReason !== null,
            ];
        }, 3);

        return response()->json([
            'received' => true,
            'duplicate' => $result['duplicate'],
            'paymentReview' => $result['review'],
        ]);
    }
}
